{
  "name": "fid-coder",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop app for local AI agents",
  "author": "Fid Coder",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:node": "npm run clean && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "dev": "npm run build:node && concurrently -k -n vite,main,preload,electron -c blue,green,yellow,magenta \"vite\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 dist/main/index.js dist/preload/index.js && electron .\"",
    "build": "npm run build:node && vite build",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:integration": "npm run build:node && node --test \"tests/integration/*.test.cjs\" \"tests/integration/*.test.mjs\"",
    "test:features": "npm run build:node && node tests/e2e-live/changes-context.e2e.mjs",
    "test:skills": "npm run build:node && node tests/e2e-live/skills.e2e.mjs",
    "test:routines": "npm run build:node && node tests/e2e-live/routines-ui.e2e.mjs",
    "test:routines-live": "npm run build:node && node tests/e2e-live/routines-live.e2e.mjs",
    "test:model-switch": "npm run build:node && electron tests/e2e-live/model-switch.e2e.cjs",
    "test:changes": "npm run build:node && node tests/e2e-live/changes-ui.e2e.mjs",
    "start": "electron .",
    "test:skills-reuse": "npm run build:node && node tests/e2e-live/skills-reuse.e2e.mjs",
    "test:map": "npm run build:node && node tests/e2e-live/project-map.e2e.mjs",
    "test:enhance": "npm run build:node && node tests/e2e-live/enhance-prompt.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@github/copilot-sdk": "^1.0.32",
    "@vscode/ripgrep": "^1.18.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.72.0",
    "mermaid": "^12.3.0",
    "node-cron": "^4.6.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "koffi@3.3.6": true
  },
  "overrides": {
    "node-abi": "4.39.0"
  },
  "build": {
    "appId": "com.fidcoder.desktop",
    "productName": "Fid Coder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@vscode/ripgrep-win32-x64/bin/rg.exe",
        "to": "ripgrep/rg.exe"
      },
      {
        "from": "skills",
        "to": "skills"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
